generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MemoryType {
  BORROWED
  STORED
  LAST_DONE
  PROMISED
}

model Memory {
  id          String     @id @default(uuid())
  type        MemoryType
  title       String
  summary     String
  content     String
  metadata    Json
  occurredAt  DateTime?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([type])
  @@index([dueAt])
  @@index([createdAt])
}
